---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import Prompt from '../components/Prompt.astro';
import EntryList from '../components/EntryList.astro';
import Pulse from '../components/Pulse.astro';
import CamFrame from '../components/CamFrame.astro';
import { profile, roadmap, projects } from '../data/profile';
import { sections, sectionKeys, getLatest } from '../lib/sections';

const latest = await getLatest(5);
const statusLabel = { done: 'done', wip: 'in progress', next: 'next', goal: 'goal' };
---

<Base>
  <section class="wrap hero">
    <div class="hero__text">
      <span class="kicker">hunting the next shell<span class="dots" aria-hidden="true"><i>.</i><i>.</i><i>.</i></span></span>
      <h1>Still learning.<br /><em>Never done.</em></h1>
      <p class="lead">Offensive security research, write-ups and labs. An eternal student of the adversary’s mind.</p>
      <p class="muted small">Just code, notes and the relentless pursuit of how things break.</p>
      <div class="btns">
        <a class="btn" href="/research/">Enter the Observatory</a>
        <a class="btn btn--ghost" href="/write-ups/">Read the Hunts</a>
      </div>
    </div>
    <div class="hero__art">
      <CamFrame>
        <div class="feed">
          <img class="feed__bg" src="/img/hero-puppet.webp" alt="Painted figure pulling the strings of a puppet" width="800" height="1200" />
          <p class="feed__title poster">Who pulls<br />the strings?</p>
          <p class="feed__sub">// still watching.</p>
        </div>
      </CamFrame>
    </div>
  </section>

  <section class="wrap block">
    <div class="panel road">
      <Terminal title={`${profile.handle}@${profile.host}`}>
        <Prompt cmd="whoami" />
        <div class="out ember">{profile.whoami}</div>
        <Prompt cmd="cat goal.txt" />
        {profile.goal.map((g) => <div class="out"><span class="blood">&gt; </span>{g}</div>)}
        <Prompt cmd="ls published/" />
        <div class="out ls">
          {sectionKeys.map((s) => <a href={`/${s}/`}>{s}/</a>)}
        </div>
        <div class="cursor-line"><Prompt cmd="" /><span class="cursor" aria-hidden="true"></span></div>
      </Terminal>
      <div class="road__text">
        <span class="kicker">the road</span>
        <h2>Red Team <em>Operator.</em></h2>
        <p class="muted">{profile.goal[1]}.</p>
        <ol class="tl">
          {
            roadmap.map((s) => (
              <li class={`st-${s.status}`}>
                <span class="tl__dot" aria-hidden="true"></span>
                <b>{s.name}</b>
                <span class="tl__s">
                  {statusLabel[s.status]}
                  {s.cert && ` · ${s.cert}`}
                </span>
                <span class="tl__f">{s.focus.join(' · ')}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="wrap block">
    <div class="note">
      <div>
        <span class="kicker">note to self</span>
        <ul class="checks">
          <li class="done">Enumerate everything.</li>
          <li class="done">Break it in the lab.</li>
          <li>Write it down.</li>
          <li>Own the domain.</li>
        </ul>
      </div>
      <p class="note__quote">Late nights in the lab.<br /><em>Quiet progress.</em></p>
    </div>
  </section>

  <Pulse />

  <section class="wrap block block--tight">
    <span class="kicker">the sanctum</span>
    <h2>Four rooms. <em>One operator.</em></h2>
    <div class="grid rooms">
      {
        sectionKeys.map((s) => (
          <a class="cell" href={`/${s}/`}>
            <span class="kicker">{sections[s].kicker}</span>
            <h3>{sections[s].name}</h3>
            <p class="muted">{sections[s].blurb}</p>
            <span class="cell__go">/{s} →</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap block">
    <div class="head-row">
      <div>
        <span class="kicker">latest</span>
        <h2>Fresh from <em>the dark.</em></h2>
      </div>
    </div>
    <EntryList items={latest} showSection />
  </section>

  <section class="wrap block">
    <span class="kicker">from github</span>
    <h2>Projects.</h2>
    <div class="grid">
      {
        projects.map((p) => (
          <a class="cell" href={p.url} rel="noopener">
            <h3>{p.name}</h3>
            <p class="muted">{p.desc}</p>
            <span>
              {p.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <Pulse />

  <section class="wrap block block--tight">
    <div class="panel rules">
      <span class="kicker">rules of engagement</span>
      <h2>Authorized. <em>Always.</em></h2>
      <ol>
        <li>Everything here runs in my own labs, on retired machines or under written authorization.</li>
        <li>No client data. No internal IPs, hostnames or credentials. Ever.</li>
        <li>Prove the impact. Take only what proves it.</li>
      </ol>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
    padding-top: 64px;
  }
  .small {
    font-size: 0.85rem;
  }
  /* dots light up one by one */
  .dots i {
    font-style: normal;
    opacity: 0.15;
    animation: dot 1.4s infinite;
  }
  .dots i:nth-child(2) {
    animation-delay: 0.2s;
  }
  .dots i:nth-child(3) {
    animation-delay: 0.4s;
  }
  @keyframes dot {
    0%, 60%, 100% { opacity: 0.15; }
    20%, 40% { opacity: 1; color: var(--blood); }
  }
  .feed {
    position: absolute;
    inset: 0;
    display: grid;
    justify-items: center;
    align-content: end;
    padding: 0 10% 20%;
    text-align: center;
  }
  .feed__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }
  .feed__title {
    position: relative;
    margin: 0;
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
    color: #ece6e2;
    text-shadow: 0 2px 18px #000, 0 0 2px #000;
  }
  .feed__sub {
    position: relative;
    margin: 12px 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: #d0c8c4;
    text-shadow: 0 1px 6px #000;
  }
  .block {
    margin-top: 110px;
  }
  .block--tight {
    margin-top: 70px;
  }

  .note {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 40px 80px;
    align-items: center;
  }
  .checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .checks li::before {
    content: '☐ ';
    color: var(--muted);
  }
  .checks li.done::before {
    content: '☑ ';
    color: var(--blood);
  }
  .checks li.done {
    color: var(--muted);
    text-decoration: line-through;
    text-decoration-color: var(--rust);
  }
  .note__quote {
    margin: 0;
    font-size: clamp(1.4rem, 3.4vw, 2.1rem);
    line-height: 1.25;
    text-align: right;
  }
  .note__quote em {
    font-family: var(--font-serif);
    color: var(--blood);
    filter: url(#distress);
  }
  .block > h2,
  .head-row {
    margin-bottom: 36px;
  }

  .road {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    padding: 36px;
  }
  .road__text h2 {
    margin-bottom: 12px;
  }
  .out {
    color: var(--muted);
  }
  .out + :global(.prompt) {
    margin-top: 12px;
  }
  .ember {
    color: var(--ember);
  }
  .blood {
    color: var(--blood);
  }
  .ls {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 20px;
  }
  .ls a {
    color: var(--ember);
  }
  .cursor-line {
    display: flex;
    align-items: center;
    margin-top: 12px;
  }
  .cursor {
    width: 9px;
    height: 1.1em;
    margin-left: 2px;
    background: var(--blood);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  /* roadmap timeline */
  .tl {
    list-style: none;
    margin: 26px 0 0 6px;
    padding: 0;
    border-left: 1px solid var(--line);
  }
  .tl li {
    position: relative;
    display: grid;
    padding: 0 0 16px 20px;
  }
  .tl li:last-child {
    padding-bottom: 0;
  }
  .tl__dot {
    position: absolute;
    left: -6px;
    top: 6px;
    width: 11px;
    height: 11px;
    border: 1px solid var(--line);
    background: var(--bg);
  }
  .tl b {
    color: var(--text);
  }
  .tl__s {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tl__f {
    font-size: 0.75rem;
    color: #6f6f6c;
  }
  .st-done .tl__dot {
    background: var(--muted);
    border-color: var(--muted);
  }
  .st-wip .tl__dot {
    background: var(--blood);
    border-color: var(--blood);
    box-shadow: 0 0 6px rgb(216 31 38 / 0.6);
  }
  .st-wip .tl__s {
    color: var(--blood);
  }
  .st-next b {
    color: #6f6f6c;
  }
  .st-goal .tl__dot {
    border-color: var(--ember);
  }
  .st-goal b,
  .st-goal .tl__s {
    color: var(--ember);
  }

  /* shared-border grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .rooms {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .cell {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px 24px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    text-decoration: none;
    color: var(--text);
  }
  .cell:hover {
    background: #120709;
    color: var(--text);
  }
  .cell:hover h3 {
    color: var(--ember);
  }
  .cell .kicker {
    margin: 0;
  }
  .cell h3 {
    margin: 0;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    transition: color 0.15s;
  }
  .cell p {
    margin: 0;
    font-size: 0.88rem;
    flex: 1;
  }
  .cell__go {
    font-size: 0.8rem;
    color: var(--blood);
  }
  .cell .tag {
    margin-right: 6px;
  }

  .rules {
    padding: 44px 40px;
  }
  .rules ol {
    margin: 28px 0 0;
    padding-left: 22px;
    display: grid;
    gap: 10px;
  }
  .rules li::marker {
    color: var(--blood);
  }

  @media (max-width: 820px) {
    .hero,
    .road {
      grid-template-columns: 1fr;
    }
    .hero {
      padding-top: 40px;
    }
    .note {
      grid-template-columns: 1fr;
    }
    .note__quote {
      text-align: left;
    }
    .road,
    .rules {
      padding: 22px;
    }
  }
</style>
