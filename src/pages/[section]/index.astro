---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { sections, sectionKeys, getEntries, type SectionKey } from '../../lib/sections';

export function getStaticPaths() {
  return sectionKeys.map((section) => ({ params: { section } }));
}

const section = Astro.params.section as SectionKey;
const { name, kicker, blurb } = sections[section];
const items = (await getEntries(section)).map((entry) => ({ section, entry }));
---

<Base title={name} description={blurb}>
  <div class="wrap">
    <header class="head">
      <span class="kicker">{kicker}</span>
      <h1 class="poster">{name}</h1>
      <p class="lead">{blurb}</p>
      <p class="muted count">{items.length} {items.length === 1 ? 'entry' : 'entries'} · /{section}</p>
    </header>
    <EntryList items={items} />
  </div>
</Base>

<style>
  .head {
    padding: 64px 0 40px;
  }
  h1 {
    font-size: clamp(2.6rem, 9vw, 5.2rem);
  }
  .lead {
    margin: 22px 0 0;
  }
  .count {
    font-size: 0.78rem;
    margin: 18px 0 0;
  }
</style>
