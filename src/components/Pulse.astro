---
// heartbeat divider
---

<div class="pulse" aria-hidden="true">
  <svg viewBox="0 0 600 40" preserveAspectRatio="none">
    <polyline
      points="0,20 255,20 268,20 276,8 284,32 292,2 302,36 310,20 322,20 330,14 338,20 600,20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      vector-effect="non-scaling-stroke"></polyline>
  </svg>
</div>

<style>
  .pulse {
    color: var(--blood);
    margin: 90px auto 0;
    max-width: 520px;
    height: 34px;
    mask-image: linear-gradient(to right, transparent, #000 25%, #000 75%, transparent);
  }
  .pulse svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 4px rgb(216 31 38 / 0.6));
  }
</style>
