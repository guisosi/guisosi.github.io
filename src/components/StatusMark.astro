---
import type { Status } from '../content.config';
import { useT, type Lang } from '../i18n/ui';

interface Props {
  status: Status;
  lang?: Lang;
}
const { status, lang = 'en' } = Astro.props;
const t = useT(lang);
---

<span class={`sm sm--${status}`}>{t(`status.${status}`)}</span>

<style>
  /* plain ink, like a note on a file */
  .sm {
    font-style: italic;
    letter-spacing: 0.02em;
  }
  .sm--finished,
  .sm--pwned {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
</style>
