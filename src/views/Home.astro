---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import Prompt from '../components/Prompt.astro';
import EntryList from '../components/EntryList.astro';
import Pulse from '../components/Pulse.astro';
import CamFrame from '../components/CamFrame.astro';
import { profile, roadmap, projects, pt } from '../data/profile';
import { sec, sectionKeys, getLatest, getFeatured, fmtDate, slugOf } from '../lib/sections';
import { useT, localize, rich, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const L = (p: string) => localize(lang, p);
const isPt = lang === 'pt';

const latest = await getLatest(5, lang);
const featured = await getFeatured(lang);
const whoami = profile.whoami;
const goal = isPt ? pt.goal : profile.goal;
const road = roadmap;
const projs = projects.map((p, i) => (isPt ? { ...p, desc: pt.projects[i] } : p));
const featHref = featured && L(`/${featured.section}/${slugOf(featured.entry)}/`);
---

<Base lang={lang}>
  <section class="wrap hero">
    <div class="hero__text">
      <span class="kicker">{t('home.kicker')}<span class="dots" aria-hidden="true"><i>.</i><i>.</i><i>.</i></span></span>
      <h1>{t('home.h1a')}<br /><em>{t('home.h1b')}</em></h1>
      <p class="lead">{t('home.lead')}</p>
      <p class="muted small">{t('home.small')}</p>
      <div class="btns">
        <a class="btn" href={L('/research/')}>{t('home.cta1')}</a>
        <a class="btn btn--ghost" href={L('/write-ups/')}>{t('home.cta2')}</a>
      </div>
    </div>
    <div class="hero__art">
      <CamFrame>
        <div class="feed">
          <img class="feed__bg" src="/img/hero-puppet.webp" alt={t('home.art')} width="800" height="1200" />
          <p class="feed__title poster">{t('home.artTitle1')}<br />{t('home.artTitle2')}</p>
          <p class="feed__sub">{t('home.artSub')}</p>
        </div>
      </CamFrame>
    </div>
  </section>

  <section class="wrap block">
    <div class="panel road">
      <Terminal title={`${profile.handle}@${profile.host}`}>
        <Prompt cmd="whoami" />
        <div class="out ember">{whoami}</div>
        <Prompt cmd="cat goal.txt" />
        {goal.map((g) => <div class="out"><span class="blood">&gt; </span>{g}</div>)}
        <Prompt cmd="ls published/" />
        <div class="out ls">
          {sectionKeys.map((s) => <a href={L(`/${s}/`)}>{s}/</a>)}
        </div>
        <div class="cursor-line"><Prompt cmd="" /><span class="cursor" aria-hidden="true"></span></div>
      </Terminal>
      <div class="road__text">
        <span class="kicker">{t('home.road')}</span>
        <h2>Red Team <em>Operator.</em></h2>
        <p class="muted">{goal[1]}.</p>
        <ol class="tl">
          {
            road.map((s) => (
              <li class={`st-${s.status}`}>
                <span class="tl__dot" aria-hidden="true"></span>
                <b>{s.name}</b>
                <span class="tl__s">
                  {t(`road.${s.status}`)}
                  {s.cert && ` · ${s.cert}`}
                </span>
                <span class="tl__f">{s.focus.join(' · ')}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="wrap block">
    <div class="note">
      <div>
        <span class="kicker">{t('home.noteKicker')}</span>
        <ul class="checks">
          {t('home.note').map((n, i) => <li class={i < 2 ? 'done' : undefined}>{n}</li>)}
        </ul>
      </div>
      <p class="note__quote">{t('home.quote1')}<br /><em>{t('home.quote2')}</em></p>
    </div>
  </section>

  <Pulse />

  <section class="wrap block block--tight">
    <span class="kicker">{t('home.sanctum')}</span>
    <h2>{t('home.rooms1')} <em>{t('home.rooms2')}</em></h2>
    <div class="grid rooms">
      {
        sectionKeys.map((s) => (
          <a class="cell" href={L(`/${s}/`)}>
            <span class="kicker">{sec(s, lang).kicker}</span>
            <h3>{sec(s, lang).name}</h3>
            <p class="muted" set:html={rich(sec(s, lang).blurb)} />
            <span class="cell__go">/{s} →</span>
          </a>
        ))
      }
    </div>
  </section>

  {
    featured && (
      <section class="wrap block">
        <span class="kicker">{t('home.case')}</span>
        <article class="featured">
          <div class="featured__text">
            <p class="featured__meta muted">
              {fmtDate(featured.entry.data.date)} · {sec(featured.section, lang).type}
            </p>
            <h2>
              <a href={featHref} set:html={rich(featured.entry.data.title)} />
            </h2>
            <p class="muted" set:html={rich(featured.entry.data.description)} />
            <p class="featured__go">
              <a class="btn" href={featHref}>{t('home.read')}</a>
              {featured.entry.data.repo && (
                <a class="btn btn--ghost" href={featured.entry.data.repo} rel="noopener">Repo ↗</a>
              )}
            </p>
          </div>
          <a class="featured__art" href={featHref} tabindex="-1" aria-hidden="true">
            <picture>
              <source media="(max-width: 560px)" srcset={`/img/posts/${slugOf(featured.entry)}/killchain-tall.svg`} width="400" height="532" />
              <img src={`/img/posts/${slugOf(featured.entry)}/killchain-wide.svg`} alt="" loading="lazy" width="760" height="500" />
            </picture>
          </a>
        </article>
      </section>
    )
  }

  <section class="wrap block">
    <div class="head-row">
      <div>
        <span class="kicker">{t('home.latest')}</span>
        <h2>{t('home.latest1')} <em>{t('home.latest2')}</em></h2>
      </div>
    </div>
    <EntryList items={latest} lang={lang} showSection />
  </section>

  <section class="wrap block">
    <span class="kicker">{t('home.github')}</span>
    <h2>{t('home.projects')}</h2>
    <div class="grid">
      {
        projs.map((p) => (
          <a class="cell" href={p.url} rel="noopener">
            <h3>{p.name}</h3>
            <p class="muted" set:html={rich(p.desc)} />
            <span>
              {p.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <Pulse />

  <section class="wrap block block--tight">
    <div class="panel rules">
      <span class="kicker">{t('home.rulesKicker')}</span>
      <h2>{t('home.rules1')} <em>{t('home.rules2')}</em></h2>
      <ol>
        {t('home.rules').map((r) => <li set:html={rich(r)} />)}
      </ol>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
    padding-top: 64px;
  }
  .small {
    font-size: 0.85rem;
  }
  /* dots light up one by one */
  .dots i {
    font-style: normal;
    opacity: 0.15;
    animation: dot 1.4s infinite;
  }
  .dots i:nth-child(2) {
    animation-delay: 0.2s;
  }
  .dots i:nth-child(3) {
    animation-delay: 0.4s;
  }
  @keyframes dot {
    0%, 60%, 100% { opacity: 0.15; }
    20%, 40% { opacity: 1; color: var(--blood); }
  }
  .feed {
    position: absolute;
    inset: 0;
    display: grid;
    justify-items: center;
    align-content: end;
    padding: 0 10% 20%;
    text-align: center;
  }
  .feed__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }
  .feed__title {
    position: relative;
    margin: 0;
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
    color: #ece6e2;
    text-shadow: 0 2px 18px #000, 0 0 2px #000;
  }
  .feed__sub {
    position: relative;
    margin: 12px 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: #d0c8c4;
    text-shadow: 0 1px 6px #000;
  }
  .featured {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 32px;
    align-items: center;
    margin-top: 18px;
    padding: 28px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .featured h2 {
    margin: 6px 0 12px;
  }
  .featured h2 a {
    text-decoration: none;
  }
  .featured__meta {
    margin: 0;
    font-size: 0.78rem;
  }
  .featured__go {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 20px 0 0;
  }
  .featured__art img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }
  @media (max-width: 860px) {
    .featured {
      grid-template-columns: 1fr;
      padding: 20px;
    }
  }
  .block {
    margin-top: 110px;
  }
  .block--tight {
    margin-top: 70px;
  }

  .note {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 40px 80px;
    align-items: center;
  }
  .checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .checks li::before {
    content: '☐ ';
    color: var(--muted);
  }
  .checks li.done::before {
    content: '☑ ';
    color: var(--blood);
  }
  .checks li.done {
    color: var(--muted);
    text-decoration: line-through;
    text-decoration-color: var(--rust);
  }
  .note__quote {
    margin: 0;
    font-size: clamp(1.4rem, 3.4vw, 2.1rem);
    line-height: 1.25;
    text-align: right;
  }
  .note__quote em {
    font-family: var(--font-serif);
    color: var(--blood);
    filter: url(#distress);
  }
  .block > h2,
  .head-row {
    margin-bottom: 36px;
  }

  .road {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    padding: 36px;
  }
  .road__text h2 {
    margin-bottom: 12px;
  }
  .out {
    color: var(--muted);
  }
  .out + :global(.prompt) {
    margin-top: 12px;
  }
  .ember {
    color: var(--ember);
  }
  .blood {
    color: var(--blood);
  }
  .ls {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 20px;
  }
  .ls a {
    color: var(--ember);
  }
  .cursor-line {
    display: flex;
    align-items: center;
    margin-top: 12px;
  }
  .cursor {
    width: 9px;
    height: 1.1em;
    margin-left: 2px;
    background: var(--blood);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  /* roadmap timeline */
  .tl {
    list-style: none;
    margin: 26px 0 0 6px;
    padding: 0;
    border-left: 1px solid var(--line);
  }
  .tl li {
    position: relative;
    display: grid;
    padding: 0 0 16px 20px;
  }
  .tl li:last-child {
    padding-bottom: 0;
  }
  .tl__dot {
    position: absolute;
    left: -6px;
    top: 6px;
    width: 11px;
    height: 11px;
    border: 1px solid var(--line);
    background: var(--bg);
  }
  .tl b {
    color: var(--text);
  }
  .tl__s {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tl__f {
    font-size: 0.75rem;
    color: #6f6f6c;
  }
  .st-done .tl__dot {
    background: var(--muted);
    border-color: var(--muted);
  }
  .st-wip .tl__dot {
    background: var(--blood);
    border-color: var(--blood);
    box-shadow: 0 0 6px rgb(216 31 38 / 0.6);
  }
  .st-wip .tl__s {
    color: var(--blood);
  }
  .st-next b {
    color: #6f6f6c;
  }
  .st-goal .tl__dot {
    border-color: var(--ember);
  }
  .st-goal b,
  .st-goal .tl__s {
    color: var(--ember);
  }

  /* shared-border grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .rooms {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .cell {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px 24px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    text-decoration: none;
    color: var(--text);
  }
  .cell:hover {
    background: #120709;
    color: var(--text);
  }
  .cell:hover h3 {
    color: var(--ember);
  }
  .cell .kicker {
    margin: 0;
  }
  .cell h3 {
    margin: 0;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    transition: color 0.15s;
  }
  .cell p {
    margin: 0;
    font-size: 0.88rem;
    flex: 1;
  }
  .cell__go {
    font-size: 0.8rem;
    color: var(--blood);
  }
  .cell .tag {
    margin-right: 6px;
  }

  .rules {
    padding: 44px 40px;
  }
  .rules ol {
    margin: 28px 0 0;
    padding-left: 22px;
    display: grid;
    gap: 10px;
  }
  .rules li::marker {
    color: var(--blood);
  }

  @media (max-width: 820px) {
    .hero,
    .road {
      grid-template-columns: 1fr;
    }
    .hero {
      padding-top: 40px;
    }
    .note {
      grid-template-columns: 1fr;
    }
    .note__quote {
      text-align: left;
    }
    .road,
    .rules {
      padding: 22px;
    }
  }
</style>
