---
import '../styles/global.css';
import Banner from '../components/Banner.astro';
import { sec, sectionKeys, shortName } from '../lib/sections';
import { profile } from '../data/profile';
import { useT, localize, unlocalize, htmlLang, ogLocale, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  // pages without a twin in the other language (404)
  single?: boolean;
}

const { lang = 'en', single = false } = Astro.props;
const t = useT(lang);
const { title, description = t('site.description') } = Astro.props;
const pageTitle = title ? `${title} | guisosi` : 'guisosi';
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = unlocalize(Astro.url.pathname);
const current = base.split('/')[1];
const L = (p: string) => localize(lang, p);
const alt = { en: base, pt: localize('pt', base) };

// static site, no third parties
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
].join('; ');
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      !single && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(alt.en, Astro.site)} />
          <link rel="alternate" hreflang="pt-BR" href={new URL(alt.pt, Astro.site)} />
          <link rel="alternate" hreflang="x-default" href={new URL(alt.en, Astro.site)} />
          <script is:inline src="/lang.js"></script>
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="guisosi" href="/rss.xml" />
    <meta name="theme-color" content="#080808" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <svg class="defs" width="0" height="0" aria-hidden="true">
      <filter id="distress">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="1" seed="2"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" scale="2.6"></feDisplacementMap>
      </filter>
    </svg>
    <a class="skip sr-only" href="#content">{t('site.skip')}</a>

    <div class="topbar">
      <div class="wrap topbar__inner">
        <a href={L('/')}>GUISOSI</a>
        <span class="topbar__tag">{t('site.tagline')}</span>
        {
          !single && (
            <span class="langs" role="group" aria-label={t('nav.lang')}>
              <a href={alt.en} hreflang="en" lang="en" data-lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
              <i aria-hidden="true">·</i>
              <a href={alt.pt} hreflang="pt-BR" lang="pt-BR" data-lang="pt" aria-current={lang === 'pt' ? 'true' : undefined}>PT</a>
            </span>
          )
        }
      </div>
    </div>

    <header class="masthead">
      <div class="wrap">
        <Banner animate={current === ''} />
        <p class="motto">* i break in so they can't. *</p>
        <nav aria-label="main">
          <ul>
            <li><a href={L('/')} aria-current={current === '' ? 'page' : undefined}>{t('nav.about')}</a></li>
            {
              sectionKeys.map((s) => (
                <li>
                  <a href={L(`/${s}/`)} title={sec(s, lang).name} aria-current={current === s ? 'page' : undefined}>
                    {shortName(s, lang)}
                  </a>
                </li>
              ))
            }
            <li><a href={profile.github} rel="me noopener">GitHub ↗</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot__inner">
        <p>{t('foot.legal')}</p>
        <p class="elsewhere">
          <a class="muted" href={profile.github} rel="me noopener">github</a>
          <span aria-hidden="true">·</span>
          <a class="muted" href="/rss.xml">rss</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip:focus {
    position: fixed;
    top: 8px;
    left: 8px;
    width: auto;
    height: auto;
    clip: auto;
    padding: 6px 10px;
    background: var(--blood);
    color: var(--text);
    z-index: 10;
  }
  .topbar__inner {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 14px;
    padding-bottom: 14px;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .topbar a {
    text-decoration: none;
  }
  .topbar__tag {
    flex: 1;
    text-align: right;
    color: var(--muted);
  }
  .langs {
    display: flex;
    gap: 6px;
  }
  .langs a {
    color: var(--muted);
  }
  .langs a:hover,
  .langs a[aria-current] {
    color: var(--text);
  }
  .langs a[aria-current] {
    border-bottom: 1px solid var(--blood);
  }
  .langs i {
    font-style: normal;
    color: var(--blood);
  }
  @media (max-width: 560px) {
    .topbar__tag {
      display: none;
    }
    .langs {
      margin-left: auto;
    }
  }
  .masthead {
    padding-top: 28px;
  }
  .motto {
    margin: 14px 0 28px;
    text-align: center;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    color: var(--muted);
  }
  nav {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  nav ul {
    display: flex;
    gap: 0 30px;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav a {
    display: block;
    padding: 14px 0 12px;
    border-bottom: 2px solid transparent;
    font-size: 0.85rem;
    white-space: nowrap;
    text-decoration: none;
    color: var(--muted);
  }
  nav a:hover {
    color: var(--text);
  }
  nav a[aria-current='page'] {
    color: var(--text);
    border-bottom-color: var(--blood);
  }
  .defs {
    position: absolute;
  }
  .foot {
    margin-top: 110px;
  }
  .foot__inner {
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 26px;
    padding-bottom: 32px;
    font-size: 0.8rem;
  }
  .foot p {
    margin: 0;
  }
  .elsewhere span {
    margin: 0 8px;
    color: var(--blood);
  }
</style>
